    <p id="message"></p>
  </div>

</div>

<script>
function calcular(){
  let total = 0;
  for(let i=1; i<=28; i++){
    const q = document.querySelector(`input[name="q${i}"]:checked`);
    if(!q){
      alert("⚠️ Debes responder todas las preguntas");
      return;
    }
    total += Number(q.value);
  }

  document.getElementById("result").style.display = "block";
  document.getElementById("score").textContent = "Tu puntuación es: " + total;

  let msg="";
  if(total <= 40) msg="🌱 Impacto ecológico MUY bajo. ¡Excelente!";
  else if(total <= 65) msg="♻️ Impacto moderado. Puedes mejorar.";
  else msg="🌍 Impacto alto. Revisa tus hábitos ambientales.";

  document.getElementById("message").textContent = msg;
}

function reiniciar(){
  document.querySelectorAll('input[type="radio"]').forEach(r => r.checked=false);
  document.getElementById("result").style.display="none";
}
</script>

</body>
