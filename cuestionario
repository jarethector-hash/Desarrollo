<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Cuestionario de Huella Ecológica</title>

  <style>
    :root{
      --bg:#0f172a;
      --panel:#111827;
      --card:#1f2937;
      --accent:#10b981;
      --text:#e5e7eb;
      --muted:#9ca3af;
      --bad:#ef4444;
      --mid:#f59e0b;
      --good:#10b981;
    }

    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:system-ui;
      background:#0f172a;
      color:var(--text);
    }

    header{
      padding:2rem 1rem;
      background:#111827;
      border-bottom:1px solid #1f2937;
      text-align:center;
    }
    header h1{
      margin:0 0 .5rem;
      font-size:2rem;
    }
    header .subtitle{
      color:var(--muted);
      font-size:1rem;
    }

    .container{
      max-width:960px;
      margin:0 auto;
      padding:1.5rem;
    }

    .card{
      background:#1f2937;
      border:1px solid #263043;
      border-radius:14px;
      padding:1.25rem;
      margin-bottom:1.5rem;
      box-shadow:0 10px 24px rgba(0,0,0,.25);
    }
    .card h2{
      margin-top:0;
      margin-bottom:1rem;
      font-size:1.4rem;
      border-bottom:1px solid #2f3a4d;
      padding-bottom:.4rem;
    }

    .question{
      background:#202b3a;
      border:1px solid #283246;
      margin-bottom:.8rem;
      padding:.8rem;
      border-radius:10px;
    }
    .question label{
      font-weight:600;
      display:block;
      margin-bottom:.5rem;
    }

    .options{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:.5rem;
    }

    .opt{
      display:flex;
      align-items:center;
      gap:.5rem;
      background:#273243;
      border:1px solid #2f3a4d;
      padding:.5rem;
      border-radius:10px;
      cursor:pointer;
    }

    .controls{
      display:flex;
      gap:1rem;
      margin-top:1rem;
    }

    button{
      padding:.75rem 1.2rem;
      font-weight:bold;
      border-radius:10px;
      cursor:pointer;
      border:none;
    }
    .primary{
      background:linear-gradient(90deg,#0ea5e9,#22d3ee);
      color:#0b1220;
    }
    .secondary{
      background:#374151;
      color:#e5e7eb;
    }

    /* Resultado */
    #result{
      display:none;
      background:#1f2937;
      border:1px solid #263043;
      border-radius:14px;
      padding:1.25rem;
      margin-top:1rem;
    }
    #score{
      font-size:1.4rem;
      font-weight:bold;
      margin-bottom:.5rem;
    }
  </style>
</head>
<body>

